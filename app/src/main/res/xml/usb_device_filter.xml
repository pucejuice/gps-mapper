    <!-- WCH CH34x -->
    <usb-device vendor-id="6790" />
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />
    <!-- STMicroelectronics virtual COM -->
    <usb-device vendor-id="1155" />
    <!-- Quectel -->
    <usb-device vendor-id="11388" />
</resources>
